# Copy outside the repository to ~/.config/proflame2/waveform.env; chmod 600.
# Literal KEY=value syntax; no shell commands or variable interpolation.
# Environment variables already exported by the caller take precedence.
PROFLAME2_CAPTURE_ROOT=/persistent/captures/proflame2
PROFLAME2_PILOT_CONFIG=/private/config/native-pilot.json
PROFLAME2_ESPHOME_CONTAINER=builder
PROFLAME2_RECEIVER_YAML=/config/passive-receiver.yaml
PROFLAME2_RECEIVER_ADDRESS=OTA
PROFLAME2_RTL433_BIN=rtl_433
PROFLAME2_RTL433_SOURCE=/source/rtl_433
# Optional offline investigation settings:
# PROFLAME2_ANALYSIS_DATASETS=/private/config/datasets.json
# PROFLAME2_CAPTURE_SSH_HOST=capture-user@capture-host
# PROFLAME2_CAPTURE_SSH_IDENTITY=/private/keys/capture-key
